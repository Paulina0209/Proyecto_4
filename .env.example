# Copia este archivo como .env (el .env NO se sube a GitHub).

# --- Modelo de lenguaje (OpenAI / GPT) — ver docs/llm_openai.md ---
OPENAI_API_KEY=sk-...
# Opcionales:
# OPENAI_MODEL=gpt-6-luna
# OPENAI_TIMEOUT=120

# --- Agente de actualización de guías (guidelineUpdate, Claude / Anthropic) ---
# Sin llave, guidelineUpdate descarga los documentos pero no genera propuestas.
# ANTHROPIC_API_KEY=sk-ant-...     (por compatibilidad también se acepta LLM_API_KEY)
# GUIDELINE_UPDATE_MODEL=claude-sonnet-5
# GUIDELINE_UPDATE_DETECTION_MODEL=   (opcional, modelo para clasificar cambios)

# --- Observabilidad de tx_clinica y guidelineUpdate (opcional, Langfuse) ---
# LANGFUSE_PUBLIC_KEY=
# LANGFUSE_SECRET_KEY=
# LANGFUSE_HOST=https://cloud.langfuse.com
# LANGFUSE_TRACING_ENABLED=false
# LANGFUSE_MASK_DATOS_PACIENTE=true
